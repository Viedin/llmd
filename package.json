{
  "name": "llmd",
  "displayName": "LLMD",
  "description": "Markdown flow specs with @file references, for planning work with an LLM",
  "version": "0.0.6",
  "publisher": "viedin",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/viedin/llmd" },
  "homepage": "https://github.com/viedin/llmd#readme",
  "bugs": "https://github.com/viedin/llmd/issues",
  "keywords": ["llm", "spec", "claude", "codex", "agent", "markdown"],
  "categories": ["Programming Languages", "AI"],
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:llmd", "onWebviewPanel:llmd.run"],
  "contributes": {
    "languages": [
      {
        "id": "llmd",
        "aliases": [
          "LLMD"
        ],
        "extensions": [
          ".llmd"
        ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./images/file.svg", "dark": "./images/file.svg" }
      }
    ],
    "configurationDefaults": {
      "[llmd]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "commands": [
      { "command": "llmd.enter", "title": "LLMD: Enter" },
      { "command": "llmd.implement", "title": "LLMD: Implement step" },
      { "command": "llmd.plan", "title": "LLMD: Plan step" },
      { "command": "llmd.newFeature", "title": "LLMD: New feature" },
      { "command": "llmd.run", "title": "LLMD: Open step run" },
      { "command": "llmd.done", "title": "LLMD: Done with step" }
    ],
    "configuration": {
      "title": "LLMD",
      "properties": {
        "llmd.agentCommand": {
          "type": "string",
          "default": "claude --permission-mode auto",
          "markdownDescription": "The Claude Code command that runs a step when you click **Implement** or **Plan**, and answers in the step's run. LLMD runs it headless (`-p`) at the project root and adds the prompt and the session. The permission mode decides what Claude may do without asking: `auto` lets it run what's safe, like builds and tests. Anything it can't do shows as **Not allowed** in the run, with **Allow** to add it to the project's `.claude/settings.local.json`. Use `--permission-mode acceptEdits` if `auto` isn't available on your plan."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "llmd.enter", "when": "false" },
        { "command": "llmd.implement", "when": "false" },
        { "command": "llmd.plan", "when": "false" },
        { "command": "llmd.run", "when": "false" },
        { "command": "llmd.done", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "key": "enter",
        "command": "llmd.enter",
        "when": "editorTextFocus && editorLangId == llmd && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasMultipleSelections && !inSnippetMode"
      }
    ],
    "grammars": [
      {
        "language": "llmd",
        "scopeName": "text.llmd",
        "path": "./syntaxes/llmd.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node out/test.js",
    "test:e2e": "npm run compile && node out/runE2E.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
