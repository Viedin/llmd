{
  "name": "llmd",
  "displayName": "LLMD",
  "description": "Markdown flow specs with @file references, for planning work with an LLM",
  "version": "0.0.6",
  "publisher": "viedin",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/viedin/llmd" },
  "homepage": "https://github.com/viedin/llmd#readme",
  "bugs": "https://github.com/viedin/llmd/issues",
  "keywords": ["llm", "spec", "claude", "codex", "agent", "markdown"],
  "categories": ["Programming Languages", "AI"],
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./out/extension.js",
  "bin": { "llmd": "out/cli.js" },
  "activationEvents": ["onLanguage:llmd"],
  "contributes": {
    "languages": [
      {
        "id": "llmd",
        "aliases": [
          "LLMD"
        ],
        "extensions": [
          ".llmd"
        ],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./images/file.svg", "dark": "./images/file.svg" }
      }
    ],
    "configurationDefaults": {
      "[llmd]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "commands": [
      { "command": "llmd.enter", "title": "LLMD: Enter" },
      { "command": "llmd.implement", "title": "LLMD: Implement step" },
      { "command": "llmd.plan", "title": "LLMD: Plan step" }
    ],
    "configuration": {
      "title": "LLMD",
      "properties": {
        "llmd.agentCommand": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Command that starts your coding agent when you click **Implement** above a step. The step's prompt is added as one quoted argument. For example `claude`, `codex`, or `codex --model gpt-5.5`."
        },
        "llmd.planCommand": {
          "type": "string",
          "default": "claude --permission-mode plan",
          "markdownDescription": "Command that starts your coding agent in a mode that discusses without editing, when you click **Plan** above a step. The step's prompt is added as one quoted argument."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "llmd.enter", "when": "false" },
        { "command": "llmd.implement", "when": "false" },
        { "command": "llmd.plan", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "key": "enter",
        "command": "llmd.enter",
        "when": "editorTextFocus && editorLangId == llmd && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasMultipleSelections && !inSnippetMode"
      }
    ],
    "grammars": [
      {
        "language": "llmd",
        "scopeName": "text.llmd",
        "path": "./syntaxes/llmd.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node out/test.js",
    "test:e2e": "npm run compile && node out/runE2E.js",
    "prepack": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
