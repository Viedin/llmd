{
  "onEnterRules": [
    {
      "beforeText": "^\\s*[@+][\\w\\-./]+\\s*$",
      "action": { "indent": "indent", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*(-\\s+)?:\\s*[A-Za-z_]\\w*.*$",
      "action": { "indent": "indent", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*-\\s+(\\[[ xX]\\]\\s+)?[A-Za-z_]\\w*\\(.*\\).*$",
      "action": { "indent": "indent", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*-\\s+\\S.*$",
      "action": { "indent": "none", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*\\*\\s+\\S.*$",
      "action": { "indent": "none", "appendText": "* " }
    }
  ]
}
