{
  "scopeName": "text.llmd",
  "comment": "Line-based on purpose: markdown's block rules (lists, 4-space code blocks) would swallow LLMD lines. Only headings, fences and inline markdown are reused.",
  "patterns": [
    { "include": "text.html.markdown#fenced_code_block" },
    { "include": "text.html.markdown#heading" },
    {
      "name": "comment.line.double-slash.llmd",
      "match": "^\\s*//.*$"
    },
    {
      "comment": "A question: \"? ...\" or \"- ? ...\".",
      "name": "markup.bold.question.llmd",
      "match": "^\\s*(?:(-)\\s+)?(\\?).*$",
      "captures": {
        "1": { "name": "punctuation.definition.list.begin.markdown" },
        "2": { "name": "keyword.control.question.llmd" }
      }
    },
    {
      "match": "^\\s*([@+])([\\w\\-./]+)\\s*$",
      "captures": {
        "1": { "name": "keyword.operator.unit.llmd" },
        "2": { "name": "string.other.path.llmd" }
      }
    },
    {
      "match": "^\\s*(?:(-)\\s+)?(:)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "punctuation.definition.list.begin.markdown" },
        "2": { "name": "keyword.operator.type.llmd" },
        "3": { "name": "entity.name.type.llmd" }
      }
    },
    {
      "comment": "A free line: what to build, with the how left to the agent. @refs and inline markdown still work inside.",
      "begin": "^\\s*(\\*)(?=\\s)",
      "end": "$",
      "beginCaptures": { "1": { "name": "punctuation.definition.list.begin.markdown" } },
      "contentName": "markup.italic.free.llmd",
      "patterns": [
        { "name": "string.other.path.llmd", "match": "(?<![\\w@])@[\\w\\-./]+" },
        { "include": "text.html.markdown#inline" }
      ]
    },
    {
      "comment": "A check: what must hold once the step is built, \"! ...\" or \"- ! ...\". Green like an added diff line.",
      "begin": "^\\s*(?:(-)\\s+)?(!)(?=\\s|$)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.list.begin.markdown" },
        "2": { "name": "keyword.control.check.llmd" }
      },
      "contentName": "markup.inserted.check.llmd",
      "patterns": [
        { "name": "string.other.path.llmd", "match": "(?<![\\w@])@[\\w\\-./]+" },
        { "include": "text.html.markdown#inline" }
      ]
    },
    {
      "comment": "A method or function: its name gets the theme's function color.",
      "match": "^\\s*(-)\\s+(?:\\[[ xX]\\]\\s+)?~?([A-Za-z_]\\w*)(?=\\()",
      "captures": {
        "1": { "name": "punctuation.definition.list.begin.markdown" },
        "2": { "name": "entity.name.function.llmd" }
      }
    },
    {
      "match": "^\\s*(-)\\s",
      "captures": { "1": { "name": "punctuation.definition.list.begin.markdown" } }
    },
    {
      "name": "string.other.path.llmd",
      "match": "(?<![\\w@])@[\\w\\-./]+"
    },
    { "include": "text.html.markdown#inline" }
  ]
}
